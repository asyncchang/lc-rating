{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lc-rating-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "kv_namespaces": [
    {
      "binding": "LC_RATING_DATA",
      "id": "376e14658e2a4687891ca743c1dd3394",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://youyun8.github.io,http://localhost:3001",
  },
  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "JWT_SECRET"],
  },
}
