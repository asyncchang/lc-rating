{
  "name": "lc-rating",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "backend:check": "pnpm --filter lc-rating-backend check",
    "backend:deploy": "pnpm --filter lc-rating-backend deploy",
    "backend:dev": "pnpm --filter lc-rating-backend dev",
    "backend:setup": "pnpm --filter lc-rating-backend setup",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.6.2"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
